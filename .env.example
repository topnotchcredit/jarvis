# Copy to .env.local for development. Never commit real values.
# NEXT_PUBLIC_ values are compiled into browser JavaScript at BUILD time: set them before
# `next build`, and never put a secret behind that prefix (`npm run check:env` enforces this).

# --- Supabase (required) ---
NEXT_PUBLIC_SUPABASE_URL=
# Publishable (formerly "anon") key. Safe for the browser; Row Level Security is the control.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Secret (formerly "service_role") key. Server only. Bypasses Row Level Security.
SUPABASE_SECRET_KEY=

# --- App ---
# Public origin of this deployment, no trailing slash. Required in production (used in email links).
SITE_URL=http://localhost:3000
# development | staging | production. Use a separate Supabase project for each.
APP_ENV=development

# --- Needed from Milestone 2 onward (leave empty until then) ---
# 32 random bytes, base64: `openssl rand -base64 32`. Encrypts stored integration credentials.
JARVIS_ENCRYPTION_KEY=
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
# Needed from Milestone 4.
ANTHROPIC_API_KEY=
